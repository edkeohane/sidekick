{
  "manifest_version": 3,
  "name": "Sidekick",
  "version": "1.5.0",
  "description": "Summarise any page in your browser side panel using Google AI Mode. Follows your system dark mode.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "declarativeNetRequest",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Sidekick"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_framing",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "content/paywalled-sites.js",
        "content/gemini-bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle Sidekick sidebar"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}